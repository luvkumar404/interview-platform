# Copy this file to .env for local development. Never commit real credentials.

# Optional PostgreSQL connection. Leave empty to use local storage in .data/.
# Set a real connection string before running Prisma migrations.
# DATABASE_URL="postgresql://interview:change_me@localhost:5432/interview_platform?schema=public"
DATABASE_URL=

# Public application URL. NEXT_PUBLIC_ values are visible in the browser and
# embedded at build time; use your deployed URL when building for production.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Code execution service. Replace this with your Piston endpoint if self-hosted.
PISTON_API_URL=https://emkc.org/api/v2/piston

# The custom server reads these before Next.js loads .env. Set them in your
# shell or hosting environment when needed, rather than relying on this file.
# PORT=3000
# NODE_ENV=production
